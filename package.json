{
  "name": "virtual-fab",
  "displayName": "virtual-fab",
  "publisher": "rezene",
  "description": "virtual-fab",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "virtual-fab.showVirtualFab",
        "title": "Show Virtual Fab"
      },
      {
        "command": "virtual-fab.bpmn.open",
        "title": "Open BPMN Editor"
      },
      {
        "command": "virtual-fab.bpmn.create",
        "title": "Create New BPMN File"
      }
    ],
    "customEditors": [
      {
        "viewType": "virtual-fab.bpmn",
        "displayName": "Virtual Fab BPMN Editor",
        "selector": [
          {
            "filenamePattern": "*.bpmn"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "virtual-fab.bpmn.open",
          "group": "navigation",
          "when": "resourceExtname == .bpmn"
        }
      ],
      "commandPalette": [
        {
          "command": "virtual-fab.bpmn.create",
          "when": "!editorFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.1",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "css-loader": "^7.1.2",
    "esbuild": "^0.25.1",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.23.0",
    "file-loader": "^6.2.0",
    "npm-run-all": "^4.1.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "bpmn-js": "^18.5.0"
  }
}
